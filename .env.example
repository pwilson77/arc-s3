# Arc network
ARC_RPC_URL=https://testnet-rpc.arc.io
ARC_CHAIN_ID=5042002

# Token addresses (set from Arc docs contract addresses page)
USDC_ADDRESS=0x0000000000000000000000000000000000000000
USYC_ADDRESS=0x0000000000000000000000000000000000000000
PERMIT2_ADDRESS=0x0000000000000000000000000000000000000000

# Optional firewall controls
DEFAULT_GAS_LIMIT=800000

# Contract addresses after deployment
S3_INTENT_FIREWALL=0x0000000000000000000000000000000000000000
S3_ESCROW_COURTHOUSE=0x0000000000000000000000000000000000000000
S3_REPUTATION_REGISTRY=0x0000000000000000000000000000000000000000
S3_AGENT_IDENTITY_REGISTRY=0x0000000000000000000000000000000000000000

# Agent private keys
ALPHA_PRIVATE_KEY=0x
BETA_PRIVATE_KEY=0x
GAMMA_PRIVATE_KEY=0x
VALIDATOR_PRIVATE_KEY=0x

# ERC-8004 identities
ALPHA_ERC8004_ID=erc8004:arc:alpha
BETA_ERC8004_ID=erc8004:arc:beta
GAMMA_ERC8004_ID=erc8004:arc:gamma
RFB6_ERC8004_ID=erc8004:arc:rfb6

# Task economics in USDC base units (6 decimals interface)
DEFAULT_TASK_PAYMENT=1000000
DEFAULT_BOND_AMOUNT=250000

# Simulation controls
ALPHA_LOOP_MS=60000
VALIDATOR_POLL_MS=3000
GAMMA_CORRUPTION_BPS=1500
TRACE_OUTPUT_DIR=./simulation/data/traces
