# Arc network
ARC_RPC_URL=https://testnet-rpc.arc.io
ARC_CHAIN_ID=5042002
NEXT_PUBLIC_ARC_EXPLORER_URL=https://testnet.arcscan.app

# Token addresses (set from Arc docs contract addresses page)
USDC_ADDRESS=0x0000000000000000000000000000000000000000
USYC_ADDRESS=0x0000000000000000000000000000000000000000
PERMIT2_ADDRESS=0x0000000000000000000000000000000000000000

# Optional firewall controls
DEFAULT_GAS_LIMIT=800000

# Contract addresses after deployment
S3_INTENT_FIREWALL=0x0000000000000000000000000000000000000000
S3_ESCROW_COURTHOUSE=0x0000000000000000000000000000000000000000
S3_REPUTATION_REGISTRY=0x0000000000000000000000000000000000000000
S3_AGENT_IDENTITY_REGISTRY=0x0000000000000000000000000000000000000000

# Agent private keys
ALPHA_PRIVATE_KEY=0x
BETA_PRIVATE_KEY=0x
GAMMA_PRIVATE_KEY=0x
VALIDATOR_PRIVATE_KEY=0x

# ERC-8004 identities
ALPHA_ERC8004_ID=erc8004:arc:alpha
BETA_ERC8004_ID=erc8004:arc:beta
GAMMA_ERC8004_ID=erc8004:arc:gamma
RFB6_ERC8004_ID=erc8004:arc:rfb6

# Task economics in USDC base units (6 decimals interface)
DEFAULT_TASK_PAYMENT=1000000
DEFAULT_BOND_AMOUNT=250000

# Simulation controls
ALPHA_LOOP_MS=60000
VALIDATOR_POLL_MS=3000
GAMMA_CORRUPTION_BPS=1500
TRACE_OUTPUT_DIR=./simulation/data/traces

# Trace storage (Pinata/IPFS)
# Set PINATA_JWT to enable trace uploads to Pinata from simulation agents.
PINATA_JWT=
PINATA_NETWORK=public
PINATA_UPLOAD_ENABLED=false
PINATA_UPLOAD_STRICT=false
IPFS_GATEWAY_BASE_URL=https://gateway.pinata.cloud/ipfs
TRACE_EVENT_LOOKBACK_BLOCKS=50000
TRACE_IPFS_FETCH_LIMIT=40
TRACE_HEALTH_TASK_ID=

# Reward split configuration (defaults: pub 10%, val 1%, hard cap 50%)
VALIDATOR_FEE_BPS=100
RFB6_PUBLISHER_FEE_BPS=1000
RFB6_COPYTRADE_MAX_PUBLISHER_FEE_BPS=2000

# RFB5 sports arbitrage process
RFB5_ERC8004_ID=erc8004:arc:rfb5
RFB5_TESTNET_PRIVATE_KEY=0x
RFB5_AGENT_INPUT_FILE=./simulation/data/agents/rfb5-sports-quotes.jsonl
RFB5_AGENT_OUTPUT_FILE=./simulation/data/agents/rfb5-sports-arb.jsonl
RFB5_LIVE_KALSHI_BASE_URL=https://api.elections.kalshi.com
RFB5_LIVE_KALSHI_MARKETS_LIMIT=80
RFB5_LIVE_KALSHI_ORDERBOOK_CACHE_MS=30000
RFB5_LIVE_KALSHI_UNMATCHED_LIMIT=100
RFB5_LIVE_MATCH_MIN_SIMILARITY=0.22
RFB5_LIVE_MATCH_MAX_START_TIME_DELTA_HOURS=240
RFB5_MIN_NET_EDGE_BPS=80
RFB5_MIN_LEG_LIQUIDITY_USD=25
RFB5_MAX_RECOMMENDED_SIZE_USD=300
RFB5_MAX_QUOTE_AGE_MS=10000
RFB5_EXECUTION_RISK_BPS=45
RFB5_ONCHAIN_EXECUTE=false
RFB5_ONCHAIN_DRY_RUN=false
RFB5_ONCHAIN_MAX_TASKS_PER_RUN=3
RFB5_ONCHAIN_SIZE_SCALE=0.25
INTENT_DEFAULT_DEADLINE_SECONDS=600
RFB5_ONCHAIN_MIN_PAYMENT_USDC6=100000
RFB5_ONCHAIN_MAX_PAYMENT_USDC6=1000000
# Recommended for testnet live soak runs (100 USDC/day)
RFB5_ONCHAIN_DAILY_NOTIONAL_CAP_USDC6=100000000
RFB5_ONCHAIN_BOND_BPS=2500
RFB5_ONCHAIN_PUBLISHER_FEE_BPS=1000
RFB5_PUBLISHER_ADDRESS=0x
RFB5_EVENT_LOOKBACK_BLOCKS=50000
RFB5_ONCHAIN_STATE_FILE=./simulation/data/agents/rfb5-sports-arb-executor-state.json
RFB5_ONCHAIN_OUTPUT_FILE=./simulation/data/agents/rfb5-sports-arb-executor.jsonl

# Circle agent wallet integration (optional, used by policy guard + identity sync)
CIRCLE_POLICY_ENFORCE=false
CIRCLE_POLICY_REQUIRE_STATUS=true
CIRCLE_POLICY_REQUIRE_LIMITS=true
CIRCLE_WALLET_CHAIN=BASE
CIRCLE_WALLET_ADDRESS=
CIRCLE_POLICY_MIN_PER_TX_USDC=0
CIRCLE_POLICY_MIN_DAILY_USDC=0
CIRCLE_AGENT_ERC8004_ID=erc8004:arc:rfb5
CIRCLE_AGENT_WALLET_ADDRESS=
CIRCLE_SKILL_TOOL=codex
CIRCLE_FUND_METHOD=crypto
CIRCLE_FUND_AMOUNT=10
CIRCLE_FUND_OPEN=true
CIRCLE_SERVICES_QUERY=prediction markets
CIRCLE_SERVICE_URL=
CIRCLE_SERVICE_PAYLOAD={}
