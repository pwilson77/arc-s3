{
  "name": "arc-s3-monorepo",
  "private": true,
  "version": "0.1.0",
  "license": "MIT",
  "workspaces": [
    "contracts",
    "simulation",
    "ui",
    "agents/shared",
    "agents/rfb6",
    "agents/rfb5"
  ],
  "scripts": {
    "build": "npm run build -w contracts && npm run build -w simulation && npm run build -w ui",
    "typecheck": "npm run typecheck -w ui",
    "test": "npm run test -w contracts",
    "lint": "npm run lint -w simulation",
    "sim": "npm run dev -w simulation",
    "sim:intent:smoke": "npm run intent:smoke -w simulation",
    "ui": "npm run dev -w ui",
    "agent:rfb6": "npm run dev -w @arc-s3/rfb6-agent",
    "agent:rfb6:executor": "npm run executor -w @arc-s3/rfb6-agent",
    "agent:rfb6:autopilot": "npm run copytrade:autopilot -w @arc-s3/rfb6-agent",
    "agent:lifecycle:autopilot": "npm run copytrade:autopilot -w @arc-s3/rfb6-agent",
    "agent:rfb6:copytrade:loop": "node ./scripts/rfb6-copytrade-loop.mjs",
    "agent:rfb6:copytrade:loop:once": "node ./scripts/rfb6-copytrade-loop.mjs --once",
    "agent:rfb6:backtest": "npm run backtest -w @arc-s3/rfb6-agent",
    "agent:rfb5": "npm run dev -w @arc-s3/rfb5-agent",
    "agents:up": "node ./scripts/agents-up.mjs",
    "agents:rfb:up": "node ./scripts/agents-rfb-up.mjs",
    "demo": "node ./scripts/demo.mjs",
    "demo:clean": "node ./scripts/demo.mjs --clean",
    "demo:continuous": "node ./scripts/demo.mjs --continuous",
    "demo:manual": "node ./scripts/demo.mjs --continuous --no-auto-post --no-seed",
    "employer:post": "tsx ./scripts/employer/post-request.mts",
    "employer:auto": "tsx ./scripts/employer/auto-poster.mts",
    "employer:matcher": "tsx ./scripts/employer/matcher.mts",
    "employer:matcher:once": "tsx ./scripts/employer/matcher.mts --once",
    "circle:setup": "node ./scripts/circle/setup.mjs",
    "circle:status": "node ./scripts/circle/status.mjs",
    "circle:fund": "node ./scripts/circle/fund.mjs",
    "circle:services:search": "node ./scripts/circle/services-search.mjs",
    "circle:services:pay": "node ./scripts/circle/services-pay.mjs",
    "circle:sync:identity": "npm run sync:circle-wallet:arc -w @arc-s3/contracts",
    "pinata:prune": "node ./scripts/pinata/prune.mjs",
    "pinata:prune:apply": "node ./scripts/pinata/prune.mjs --apply",
    "autopilot:up": "npx pm2 startOrReload scripts/ecosystem.config.cjs --only rfb6-autopilot",
    "autopilot:down": "npx pm2 delete rfb6-autopilot || true",
    "autopilot:restart": "npx pm2 restart rfb6-autopilot",
    "autopilot:status": "npx pm2 status",
    "autopilot:logs": "npx pm2 logs rfb6-autopilot --lines 200",
    "autopilot:health": "node ./scripts/autopilot-health.mjs",
    "check:balances": "node ./scripts/check-balances.mjs",
    "check:balances:all": "node ./scripts/check-all-balances.mjs"
  }
}
